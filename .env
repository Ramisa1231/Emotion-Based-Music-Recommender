# Environment variables for Emotion-Based Music Recommender

# Path to your Spotify dataset (relative to Colab working dir)
SPOTIFY_CSV=./data/SpotifyFeatures.csv

# Hugging Face model for emotion detection
HF_EMOTION_MODEL=bhadresh-savani/distilbert-base-uncased-emotion

# Set to false so the model can download on first run
TRANSFORMERS_OFFLINE=false

# Optional: modify for other emotion models or caching
# HF_HOME=/root/.cache/huggingface
